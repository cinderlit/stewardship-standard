# ===================================================================
# SECTION 11: CARDINALITY AND ADDITIONAL AXIOMS
# ===================================================================

# A LocusRecord must have exactly one Context
qsm:LocusRecord rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty qsm:has_context ;
      owl:cardinality 1 ] .

# An AtlasRecord must have exactly one LocusRecord as source
qsm:AtlasRecord rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty qsm:produced_from ;
      owl:cardinality 1 ] .

# A StewardshipScore must have score_value between 1 and 5 (documented by minInclusive/maxInclusive)
qsm:StewardshipScore rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty qsm:score_value ;
      owl:cardinality 1 ] .

# A CapacityProfile must belong to exactly one Person
qsm:CapacityProfile rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty [ owl:inverseOf qsm:has_capacity_profile ] ;
      owl:cardinality 1 ] .

# A Subproject belongs to at most one Subarea
qsm:Subproject rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty qsm:belongs_to_subarea ;
      owl:maxCardinality 1 ] .

# A Routine belongs to at most one Subarea
qsm:Routine rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty qsm:belongs_to_subarea ;
      owl:maxCardinality 1 ] .

# Subproject, Routine, and Subarea are disjoint
qsm:Subproject owl:disjointWith qsm:Routine, qsm:Subarea .
qsm:Routine owl:disjointWith qsm:Subarea .

# LocusRecord, AtlasRecord, and TenureRecord are disjoint
qsm:LocusRecord owl:disjointWith qsm:AtlasRecord, qsm:TenureRecord .
qsm:AtlasRecord owl:disjointWith qsm:TenureRecord .

# Gap and StewardshipScore are disjoint
qsm:Gap owl:disjointWith qsm:StewardshipScore .


