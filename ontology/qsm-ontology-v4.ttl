# Source of record: intelligence-engine/handoffs/qsm-ontology.yaml. Edit there + regenerate.

<https://quantifiedstewardship.org/ontology/qsm>
    a owl:Ontology ;
    owl:versionInfo "2026-07-09.3" ;
    owl:priorVersion <https://quantifiedstewardship.org/ontology/qsm/3.0.0> ;
    rdfs:label "Quantified Stewardship Model Ontology (v4 — reconciled)" ;
    rdfs:comment "Reconciled to ADR-0010: six context types incl. ESTATE, CREST as distributed-authority governance (not community), ROOTS removed (closed dead branch), transitive part-of declared. Generated from qsm-ontology.yaml. Supersedes v3, which carried the pre-ADR-0010 taxonomy." .

# ===== SECTION 1: CORE CLASSES =====
qsm:Context a owl:Class ; rdfs:label "Context" ;
    rdfs:comment "A bounded stewardship domain with explicit scope. One of six declared types." .
qsm:StewardedContext a owl:Class ; rdfs:subClassOf qsm:Context ; rdfs:label "Stewarded Context" .
qsm:Entity a owl:Class ; rdfs:label "Entity" ;
    rdfs:comment "Any person, place, system, asset, obligation, or meaningful object in scope." .
qsm:Layer a owl:Class ; rdfs:label "QSM Layer" .
qsm:Phase a owl:Class ; rdfs:label "Stewardship Phase" .
qsm:Question a owl:Class ; rdfs:label "Core Question" .
qsm:NeedsFramework a owl:Class ; rdfs:label "Needs Framework" .
qsm:DevelopmentalFramework a owl:Class ; rdfs:label "Developmental Stage Framework" .
qsm:ManagementCategory a owl:Class ; rdfs:label "Management Category" .
qsm:SensitivityTier a owl:Class ; rdfs:label "Sensitivity Tier (TLP)" .
qsm:Family a owl:Class ; rdfs:label "Portfolio Family" .

# ===== SECTION 2: CONTEXT TYPES (ADR-0010) =====
qsm:SELF a owl:Class ; rdfs:subClassOf qsm:StewardedContext ; rdfs:label "Self" ;
    rdfs:comment "Personal stewardship — capacity, load, needs, routines, recovery. Authority: individual." .
qsm:HEARTH a owl:Class ; rdfs:subClassOf qsm:StewardedContext ; rdfs:label "Household" ;
    rdfs:comment "Household/home stewardship. First hardened context; normative reference implementation. Authority: household." .
qsm:CHARTER a owl:Class ; rdfs:subClassOf qsm:StewardedContext ; rdfs:label "Charter" ;
    rdfs:comment "Organizational/venture governance — authority held by a single steward. Has a template/instance pattern (tpl_charter → Excentropy, etc.). Authority: single_steward." .
qsm:CREST a owl:Class ; rdfs:subClassOf qsm:StewardedContext ; rdfs:label "Crest" ;
    rdfs:subClassOf qsm:CHARTER ;
    rdfs:comment "Governance whose authority is DISTRIBUTED across a board/collective/community (HOA, civic org). The distributed-authority variant of CHARTER. Distinguished from ESTATE by nature of entity (governance body vs. asset), not scale. Canonical example: WoodcrestWA. Authority: distributed_board_or_collective." .
qsm:ESTATE a owl:Class ; rdfs:subClassOf qsm:StewardedContext ; rdfs:label "Estate" ;
    rdfs:subClassOf qsm:HEARTH ;
    rdfs:comment "Property/asset stewardship, single-property through portfolio scale. Held by identified steward(s). Does not contain other contexts. Canonical example: 14143. Authority: owner_or_co_owners." .
qsm:QSM_META a owl:Class ; rdfs:subClassOf qsm:Context ; rdfs:label "QSM-Meta" ;
    rdfs:comment "Singleton, non-steward-owned governance context representing the standard/ontology layer itself. Excluded from the 5-type stewarded count. Authority: none_singleton." .

# ===== SECTION 3: OBJECT PROPERTIES =====
qsm:partOf a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:label "part of" ;
    rdfs:comment "Transitive composition. A partOf B and B partOf C entails A partOf C — inferred, not hand-maintained." .
qsm:hasPart a owl:ObjectProperty, owl:TransitiveProperty ; owl:inverseOf qsm:partOf ; rdfs:label "has part" .
qsm:extendsContext a owl:ObjectProperty ; rdfs:domain qsm:Context ; rdfs:range qsm:Context ; rdfs:label "extends context" .
qsm:governedByLayer a owl:ObjectProperty ; rdfs:range qsm:Layer ; rdfs:label "governed by layer" .
qsm:inPhase a owl:ObjectProperty ; rdfs:range qsm:Phase ; rdfs:label "in stewardship phase" .
qsm:usesNeedsFramework a owl:ObjectProperty ; rdfs:range qsm:NeedsFramework ; rdfs:label "uses needs framework" .
qsm:usesDevFramework a owl:ObjectProperty ; rdfs:range qsm:DevelopmentalFramework ; rdfs:label "uses developmental framework" .
qsm:stewardshipContext a owl:ObjectProperty ; rdfs:range qsm:Context ; rdfs:label "stewardship context" .
qsm:sensitivity a owl:ObjectProperty ; rdfs:range qsm:SensitivityTier ; rdfs:label "sensitivity tier" .
# cross-entity edges (ADR-0034/0037)
qsm:funds a owl:ObjectProperty ; rdfs:label "funds" .
qsm:maintains a owl:ObjectProperty ; rdfs:label "maintains" .
qsm:specFor a owl:ObjectProperty ; rdfs:label "spec for" .
qsm:dependsOn a owl:ObjectProperty ; rdfs:label "depends on" .
qsm:feralRegisterOf a owl:ObjectProperty ; rdfs:label "feral register of" .
qsm:prospectiveParentOf a owl:ObjectProperty ; rdfs:label "prospective parent of" .
qsm:peerOf a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "peer of" .
qsm:instanceOf a owl:ObjectProperty ; rdfs:label "instance of" .

# ===== SECTION 4: DATA PROPERTIES =====
qsm:status a owl:DatatypeProperty ; rdfs:range xsd:string .
qsm:governanceLevel a owl:DatatypeProperty ; rdfs:range xsd:string .
qsm:conformanceTarget a owl:DatatypeProperty ; rdfs:range xsd:string .
qsm:portfolioTier a owl:DatatypeProperty ; rdfs:range xsd:string .
qsm:stackLayer a owl:DatatypeProperty ; rdfs:range xsd:string .
qsm:governingQuestion a owl:DatatypeProperty ; rdfs:range xsd:string .
qsm:competenceThreshold a owl:DatatypeProperty ; rdfs:range xsd:string .

# ===== SECTION 5: CONTROLLED VOCABULARIES (individuals) =====
qsm:L1 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L1 Intent" .
qsm:L2 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L2 Governance" .
qsm:L3 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L3 Intake" .
qsm:L4 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L4 Memory" .
qsm:L5 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L5 Practice" .
qsm:L6 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L6 Observation" .
qsm:L7 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L7 Signal" .
qsm:L8 a owl:NamedIndividual, qsm:Layer ; rdfs:label "L8 Adaptation" .
qsm:phase_LOCUS a owl:NamedIndividual, qsm:Phase ; rdfs:label "LOCUS" ; rdfs:comment "ground truth exists — assess and orient" .
qsm:phase_ATLAS a owl:NamedIndividual, qsm:Phase ; rdfs:label "ATLAS" ; rdfs:comment "structure mapped — anchor and score" .
qsm:phase_TENURE a owl:NamedIndividual, qsm:Phase ; rdfs:label "TENURE" ; rdfs:comment "review loop active — measure and sustain" .
qsm:Q1 a owl:NamedIndividual, qsm:Question ; rdfs:label "Q1 Purpose" .
qsm:Q2 a owl:NamedIndividual, qsm:Question ; rdfs:label "Q2 Awareness" .
qsm:Q3 a owl:NamedIndividual, qsm:Question ; rdfs:label "Q3 Action" .
qsm:nf_max_neef a owl:NamedIndividual, qsm:NeedsFramework ; rdfs:label "max_neef" ; rdfs:comment "binds to SELF" .
qsm:nf_building_performance a owl:NamedIndividual, qsm:NeedsFramework ; rdfs:label "building_performance" ; rdfs:comment "binds to HEARTH" .
qsm:nf_well a owl:NamedIndividual, qsm:NeedsFramework ; rdfs:label "well" ; rdfs:comment "binds to ESTATE" .
qsm:nf_erg a owl:NamedIndividual, qsm:NeedsFramework ; rdfs:label "erg" ; rdfs:comment "binds to CHARTER" .
qsm:nf_maslow a owl:NamedIndividual, qsm:NeedsFramework ; rdfs:label "maslow" ; rdfs:comment "binds to (non-SELF, legacy)" .
qsm:nf_pink a owl:NamedIndividual, qsm:NeedsFramework ; rdfs:label "pink" ; rdfs:comment "binds to (optional)" .
qsm:df_business_lifecycle_7 a owl:NamedIndividual, qsm:DevelopmentalFramework ; rdfs:label "business_lifecycle_7" .
qsm:df_business_lifecycle_4 a owl:NamedIndividual, qsm:DevelopmentalFramework ; rdfs:label "business_lifecycle_4" .
qsm:df_greiner_5 a owl:NamedIndividual, qsm:DevelopmentalFramework ; rdfs:label "greiner_5" .
qsm:df_erikson a owl:NamedIndividual, qsm:DevelopmentalFramework ; rdfs:label "erikson" .
qsm:df_feline a owl:NamedIndividual, qsm:DevelopmentalFramework ; rdfs:label "feline" .
qsm:df_family_life_cycle a owl:NamedIndividual, qsm:DevelopmentalFramework ; rdfs:label "family_life_cycle" .
qsm:df_lifespan a owl:NamedIndividual, qsm:DevelopmentalFramework ; rdfs:label "lifespan" .
qsm:tlp_RED a owl:NamedIndividual, qsm:SensitivityTier ; rdfs:label "TLP:RED" ; rdfs:comment "you only — never leaves qsm-self/Spine" .
qsm:tlp_AMBER a owl:NamedIndividual, qsm:SensitivityTier ; rdfs:label "TLP:AMBER" ; rdfs:comment "named collaborator, generated snapshot (Dan, James) — aggregate/system-level only" .
qsm:tlp_GREEN a owl:NamedIndividual, qsm:SensitivityTier ; rdfs:label "TLP:GREEN" ; rdfs:comment "venture/group context, still not public" .
qsm:tlp_CLEAR a owl:NamedIndividual, qsm:SensitivityTier ; rdfs:label "TLP:CLEAR" ; rdfs:comment "public — requires explicit promotion, never automatic" .

# ===== SECTION 6: MANAGEMENT CATEGORIES (workbook) =====
qsm:mc_SELF_body_health_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Body & Health Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Is my body maintained at a baseline that enables everything else?" ;
    qsm:competenceThreshold "Sleep 7–9h consistent; nutrition adequate; exercise routine active; medical checkups current; no unmanaged chronic conditions" .
qsm:mc_SELF_energy_capacity_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Energy & Capacity Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L6 ;
    qsm:governingQuestion "Am I operating within sustainable limits — physically, cognitively, emotionally?" ;
    qsm:competenceThreshold "Peak/off-peak energy profile documented; commitments calibrated to capacity; recovery time protected; no chronic depletion pattern" .
qsm:mc_SELF_financial_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Financial Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Can I reliably meet my needs now and in the foreseeable future?" ;
    qsm:competenceThreshold "Monthly budget active; emergency fund ≥3 months; all bills current; debt managed; savings rate positive; insurance in place; taxes filed" .
qsm:mc_SELF_risk_safety_security_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Risk, Safety & Security Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L6 ;
    qsm:governingQuestion "What could disrupt my stability and am I reasonably prepared?" ;
    qsm:competenceThreshold "Personal risk register exists; digital security current (passwords, 2FA, privacy); physical safety assessed; emergency runbook drafted; legal basics in place" .
qsm:mc_SELF_relationship_social_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Relationship & Social Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Are my key relationships healthy and deepening over time?" ;
    qsm:competenceThreshold "Close relationships actively maintained with rituals; conflict resolution process known and used; boundaries set; appreciation regularly expressed" .
qsm:mc_SELF_communication_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Communication Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Do I communicate in ways that build trust, clarity, and connection?" ;
    qsm:competenceThreshold "Response time agreements set; communication style self-aware; async/sync protocols clear; expectations proactively managed" .
qsm:mc_SELF_social_community_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Social & Community Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L4 ;
    qsm:governingQuestion "Am I maintaining meaningful connection beyond my close relationships?" ;
    qsm:competenceThreshold "Network map exists and is maintained; weak ties regularly tended; community involvement active; social obligations tracked and managed" .
qsm:mc_SELF_career_professional_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Career & Professional Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L4 ;
    qsm:governingQuestion "Is my career progressing in alignment with my values and security needs?" ;
    qsm:competenceThreshold "Career strategy articulated; professional network active; skills current and developing; income trajectory managed; professional reputation intentionally cultivated" .
qsm:mc_SELF_creative_expression_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Creative & Expression Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Am I expressing myself creatively in ways that feel meaningful and alive?" ;
    qsm:competenceThreshold "Creative practice active and consistent; craft developing; creative output documented; creative community present" .
qsm:mc_SELF_learning_development a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Learning & Development" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Am I continuously growing and retaining what I learn?" ;
    qsm:competenceThreshold "Learning goals set; active learning practice; PKM system functioning; skills tracked and developing; information findable in < 60 seconds" .
qsm:mc_SELF_mental_emotional_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Mental/Emotional Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L6 ;
    qsm:governingQuestion "Am I regulating my inner state with care rather than judgment?" ;
    qsm:competenceThreshold "Emotional patterns recognized; coping strategies documented; support accessed when needed; no chronic self-punitive framing; recovery practices active" .
qsm:mc_SELF_values_meaning_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Values & Meaning Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Am I living in alignment with what I most deeply value?" ;
    qsm:competenceThreshold "Values articulated and documented; meaning sources identified; contemplative/spiritual practice consistent; values actively inform major decisions" .
qsm:mc_SELF_environment_space_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Environment & Space Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Is my physical environment supporting rest, focus, and baseline functioning?" ;
    qsm:competenceThreshold "Living/working spaces functional and maintained; clutter managed; sensory environment supports capacity; seasonal maintenance current" .
qsm:mc_SELF_information_knowledge_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Information & Knowledge Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L3 ;
    qsm:governingQuestion "Is my information organized and findable, and am I building a growing personal knowledge base?" ;
    qsm:competenceThreshold "PKM system active and trusted; information findable in < 60 seconds; reading/input processed regularly; notes synthesized not just collected" .
qsm:mc_SELF_digital_autonomy_privacy_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Digital Autonomy & Privacy Management" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Is my digital presence secure, my data protected, and my attention under my control?" ;
    qsm:competenceThreshold "Password manager active + 2FA on all critical accounts; data/privacy audit done ≤12 months ago; notification load intentionally configured; attention boundaries active" .
qsm:mc_SELF_planning_self_governance a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Planning & Self-Governance" ;
    qsm:stewardshipContext qsm:SELF ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Am I governing my time, commitments, and choices in alignment with who I intend to become?" ;
    qsm:competenceThreshold "Calendar designed around priorities; attention protected; goals and boundaries documented; decision rights clear; retrospectives active" .
qsm:mc_HEARTH_home_systems_infrastructure_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Home Systems & Infrastructure Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Are all home systems functional, maintained, and operating within spec?" ;
    qsm:competenceThreshold "All systems operational; maintenance schedules active; utilities monitored; no critical deferred maintenance; service history current" .
qsm:mc_HEARTH_property_structural_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Property & Structural Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Is the property's structural integrity and envelope maintained at a sound baseline?" ;
    qsm:competenceThreshold "No deferred structural issues; roof/foundation/envelope sound; asset register current; maintenance vendor relationships active" .
qsm:mc_HEARTH_household_financial_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Household Financial Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Can the household meet all financial obligations and maintain its systems?" ;
    qsm:competenceThreshold "Household budget active; all bills current; maintenance budget allocated; emergency fund in place; insurance current; shared financial agreements documented" .
qsm:mc_HEARTH_safety_security_emergency_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Safety, Security & Emergency Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Is the household protected from foreseeable physical risks and emergencies?" ;
    qsm:competenceThreshold "Security systems active; emergency plan documented; runbooks for key scenarios; all members briefed; risks reviewed annually" .
qsm:mc_HEARTH_health_care_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Health & Care Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Are all household members receiving appropriate care and health maintenance?" ;
    qsm:competenceThreshold "All members' medical care current; medications managed; dependent care plans in place; health records organized; care load fairly distributed" .
qsm:mc_HEARTH_household_information_documentation_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Household Information & Documentation Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L4 ;
    qsm:governingQuestion "Can any household member find and use what they need, without a single point of failure?" ;
    qsm:competenceThreshold "All home systems documented; appliance manuals organized; service history recorded; emergency info current; any member could operate the home solo for 30 days" .
qsm:mc_HEARTH_food_provisioning_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Food & Provisioning Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L3 ;
    qsm:governingQuestion "Are all household members adequately fed and provisioned consistently?" ;
    qsm:competenceThreshold "Pantry system active; meal planning consistent; no stockouts of essentials; dietary needs of all members met; procurement system reliable" .
qsm:mc_HEARTH_household_operations_coordination_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Household Operations & Coordination Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Is the household operating smoothly with fair, sustainable distribution of labor?" ;
    qsm:competenceThreshold "Chore system functioning; labor fairly distributed; recurring tasks tracked; nothing critical falling through cracks; RACI clear" .
qsm:mc_HEARTH_technology_systems_integration_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Technology & Systems Integration Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Are the home's technology and automation systems integrated and serving the household?" ;
    qsm:competenceThreshold "Smart home systems configured; automation serving daily needs; AV/entertainment functioning; network reliable; integrations maintained" .
qsm:mc_HEARTH_home_identity_environment_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Home Identity & Environment Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Does the home environment actively support how we want to live — aesthetically and sensorially?" ;
    qsm:competenceThreshold "Home aesthetic intentional; spaces designed for function and beauty; sensory environment managed; environment actively curated" .
qsm:mc_HEARTH_household_culture_relationship_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Household Culture & Relationship Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Do household members feel genuinely comfortable, connected, and respected in this home?" ;
    qsm:competenceThreshold "Household norms agreed and revisited; conflict resolution process active; shared rituals present; all voices heard; household values articulated" .
qsm:mc_HEARTH_community_social_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Community & Social Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Is the household connected to and comfortable within its surrounding community?" ;
    qsm:competenceThreshold "Neighbor relationships active; social obligations managed; hospitality practiced; community involvement present" .
qsm:mc_HEARTH_home_improvement_project_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Home Improvement & Project Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Is the home improving and adapting over time in line with our vision and resources?" ;
    qsm:competenceThreshold "Project backlog managed; current projects tracked; improvement budget allocated; contractor relationships established; completed projects documented" .
qsm:mc_HEARTH_household_governance_decision_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Household Governance & Decision Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L2 ;
    qsm:governingQuestion "Are household decisions made well, fairly, and with clear authority — enabling adaptation?" ;
    qsm:competenceThreshold "Decision rights clear; household goals set; priorities agreed; major decisions documented; governance reviewed periodically" .
qsm:mc_HEARTH_values_vision_legacy_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Values, Vision & Legacy Management" ;
    qsm:stewardshipContext qsm:HEARTH ;
    qsm:governedByLayer qsm:L4 ;
    qsm:governingQuestion "Is this home being built as something meaningful — adapting to reflect our deepest values?" ;
    qsm:competenceThreshold "Household values documented; home vision articulated; estate planning initiated; legacy managed" .
qsm:mc_ESTATE_indoor_air_quality_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Indoor Air Quality Management" ;
    qsm:stewardshipContext qsm:ESTATE ;
    qsm:governedByLayer qsm:L7 ;
    qsm:governingQuestion "Is the indoor air quality at all estate areas meeting health standards continuously?" ;
    qsm:competenceThreshold "Air quality monitoring active in key zones; filtration systems specified and maintained; ventilation rates adequate; VOC and particulate levels below thresholds" .
qsm:mc_ESTATE_ventilation_fresh_air_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Ventilation & Fresh Air Management" ;
    qsm:stewardshipContext qsm:ESTATE ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Is fresh, clean outdoor air delivered consistently throughout the estate?" ;
    qsm:competenceThreshold "Ventilation rates verified by zone; mechanical ventilation maintained; natural ventilation paths unobstructed; outdoor air quality monitored and filtered" .
qsm:mc_ESTATE_water_quality_treatment_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Water Quality & Treatment Management" ;
    qsm:stewardshipContext qsm:ESTATE ;
    qsm:governedByLayer qsm:L6 ;
    qsm:governingQuestion "Is the water supply at all points of use meeting health and quality standards?" ;
    qsm:competenceThreshold "Water tested regularly at point of use; filtration systems maintained; softening/treatment systems operational; water quality records maintained" .
qsm:mc_ESTATE_water_systems_features_management a owl:NamedIndividual, qsm:ManagementCategory ;
    rdfs:label "Water Systems & Features Management" ;
    qsm:stewardshipContext qsm:ESTATE ;
    qsm:governedByLayer qsm:L5 ;
    qsm:governingQuestion "Are all water systems and features maintained for safety, function, and quality?" ;
