{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardshipstandard.org/schemas/thrive/routine/v1.0.json",
  "title": "THRIVE Routine Schema",
  "description": "A recurring structure that stabilizes functioning. First-class object. Defined by THRIVE v1.0.1 §8.",
  "type": "object",
  "required": ["id", "label", "type"],
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["morning", "evening", "recovery", "workday-transition", "medication-health", "caregiving-support", "weekly-reset"]
    },
    "trigger_conditions": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "items": { "type": "string" } },
    "expected_duration": { "type": "string" },
    "known_failure_modes": { "type": "array", "items": { "type": "string" } },
    "fallback_options": { "type": "array", "items": { "type": "string" } }
  }
}
