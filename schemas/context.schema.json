{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardshipstandard.org/schemas/context/v1.1.json",
  "title": "TSS Context Schema",
  "description": "A bounded stewardship domain with explicit scope. Defined by TSS v1.1.1 §5.1 and §6.",
  "type": "object",
  "required": ["id", "name", "type", "stewards", "effective_date", "scope", "version"],
  "properties": {
    "id": { "type": "string", "description": "Unique context identifier." },
    "name": { "type": "string", "description": "Human-readable context name." },
    "type": {
      "type": "string",
      "enum": ["SELF", "HEARTH", "ESTATE", "CHARTER", "CREST"],
      "description": "Declared context type. Additional types MAY be added in future versions."
    },
    "stewards": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "At least one responsible steward identifier."
    },
    "effective_date": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "description": "Explicit scope boundary for the context." },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "version": { "type": "string" }
  }
}
