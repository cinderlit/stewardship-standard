{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stewardshipstandard.org/schemas/fiduciary-context/v1.0.json",
  "title": "QSM-FAI FiduciaryContext (FC) Schema",
  "description": "An agent's license to act within a stewardship context. Every QSM-FAI-conformant agent MUST hold a valid, active FiduciaryContext before taking any action. Defined by QSM-FAI v1.0.1 §3.",
  "type": "object",
  "required": ["id", "version", "context_type", "declared_by", "delegation_chain", "constraints", "status"],
  "properties": {
    "id": { "type": "string", "description": "FiduciaryContext identifier, e.g. fc-[uuid]." },
    "version": { "type": "string" },
    "context_type": {
      "type": "string",
      "enum": ["HEARTH", "CREST", "CHARTER", "SELF", "ESTATE"],
      "description": "The hardened context this FC operates within."
    },
    "label": { "type": "string", "description": "Human-readable name for this context." },
    "declared_by": {
      "type": "object",
      "required": ["steward_id", "declared_at"],
      "properties": {
        "steward_id": { "type": "string" },
        "steward_name": { "type": "string" },
        "declared_at": { "type": "string", "format": "date-time" }
      }
    },
    "delegation_chain": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of stewards/agents authorized to act. MUST include at least one primary steward (FC-04).",
      "items": {
        "type": "object",
        "required": ["steward_id", "role", "authorized_at", "scope"],
        "properties": {
          "steward_id": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "delegate", "observer"] },
          "authorized_at": { "type": "string", "format": "date-time" },
          "scope": {
            "type": "array",
            "items": { "type": "string", "enum": ["read", "recommend", "act", "delegate"] },
            "minItems": 1
          }
        }
      }
    },
    "entity_set_ref": { "type": "string", "description": "Reference to LOCUS document ID." },
    "atlas_ref": { "type": "string", "description": "Reference to ATLAS document ID." },
    "tenure_log_ref": { "type": "string", "description": "Reference to active TENURE log." },
    "constraints": {
      "type": "object",
      "required": ["max_action_tier", "require_human_approval_above_tier"],
      "properties": {
        "max_action_tier": { "type": "integer", "minimum": 0, "maximum": 4 },
        "require_human_approval_above_tier": { "type": "integer", "minimum": 0, "maximum": 4 },
        "spending_limit_usd": { "type": ["number", "null"] },
        "notification_required_for": { "type": "array", "items": { "type": "string" } },
        "prohibited_domains": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "type": "string", "enum": ["active", "suspended", "revoked", "expired"] },
    "expires_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
